# CultivaNode: every configuration value the platform uses, with where it belongs.
# Never commit real values. Real secrets live in Vercel (Project > Settings > Environment Variables)
# and Supabase (Edge Functions > Secrets). Browser/mobile-safe values start with NEXT_PUBLIC_ / EXPO_PUBLIC_.

# --- Supabase ----------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key: safe in apps because Row Level Security protects the data.
SUPABASE_ANON_KEY=sb_publishable_xxx
# Service role key: bypasses RLS. SERVER ONLY (Edge Functions, trusted jobs). Never in NEXT_PUBLIC_/EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (M5) -----------------------------------------------------------------------------
# test | live. Anything else means test. live also needs a production deployment and LIVE_PAYMENTS_APPROVED=yes
# (set only after the legal/compliance review in docs/PAYMENTS.md).
PAYMENT_MODE=test
LIVE_PAYMENTS_APPROVED=no
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- SMS and identity providers ------------------------------------------------------------------
# Not environment variables: staff choose the provider (Termii, Prembly, ...) and paste its keys in the
# admin console (/admin/integrations); keys are stored encrypted in Supabase Vault. See docs/INTEGRATIONS.md.
#
# Edge Function secrets (Supabase > Edge Functions > Secrets):
SEND_SMS_HOOK_SECRET=             # "v1,whsec_..." from Authentication > Auth Hooks > Send SMS
APP_ENV=development               # set to production before real users: test providers stop working

# --- Weather (M3) ------------------------------------------------------------------------------
# Open-Meteo needs no key for non-commercial use; set one for the commercial API.
WEATHER_API_KEY=

# --- Maps (M2) ---------------------------------------------------------------------------------
# Google Maps Platform API key (for local development only - production keys stored in Admin > Integrations)
# Enable Maps JavaScript API, Places API, and Geocoding API in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# --- AI assistant (M6) -------------------------------------------------------------------------
AI_API_KEY=

# --- Monitoring --------------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
