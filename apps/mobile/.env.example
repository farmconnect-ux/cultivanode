# Copy to .env and fill in from Supabase: Project Settings > API.
# EXPO_PUBLIC_ values are bundled into the app, so only the publishable key goes here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Website used for the terms, privacy and account links (defaults to https://cultivanode.com).
# EXPO_PUBLIC_SITE_URL=https://cultivanode.vercel.app

# Crash reports (optional). Leave empty to keep Sentry off. No personal data is ever sent.
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_APP_ENV=development
