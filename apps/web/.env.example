# Copy to .env.local and fill in from Supabase: Project Settings > API.
# These two values are safe in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Never put the service_role / secret key in a NEXT_PUBLIC_ variable.

# Public site settings (optional). Leave blank to hide.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Error monitoring (optional). Sentry starts only when a DSN is set.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Payments stay in test mode unless docs/PAYMENTS.md conditions are met.
PAYMENT_MODE=test

# Weather: no key here. Staff choose the provider and enter its key in Admin > Integrations > Weather
# (stored encrypted in Supabase Vault and used only by the `weather` Edge Function).
# AI farm assistant — Gemini answers first, OpenAI is the fallback
GEMINI_API_KEY=AQ.Ab8RN6LmTdyMZhRfQpBndTJDsx67CL3ftGbB19BMQ187EpY8NQ
OPENAI_API_KEY=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

# Optional overrides (these are the defaults)
AI_PRIMARY_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=20000