# Copy to .env.local and fill in from Supabase: Project Settings > API.
# These two values are safe in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Never put the service_role / secret key in a NEXT_PUBLIC_ variable.

# Public site settings (optional). Leave blank to hide.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
