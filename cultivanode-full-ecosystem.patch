+import type { JournalEntry, JournalPosting } from './types';
+
+async function sha256Hex(str: string): Promise<string> {
+  const enc = new TextEncoder();
+  const buffer = await crypto.subtle.digest('SHA-256', enc.encode(str));
+  const hashArray = Array.from(new Uint8Array(buffer));
+  return hashArray.map((b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+export class CryptographicLedger {
+  private entries: JournalEntry[] = [];
+  private lastHash = '0'.repeat(64); // Genesis hash
+
+  constructor(initialEntries: JournalEntry[] = []) {
+    if (initialEntries.length > 0) {
+      this.entries = [...initialEntries];
+      this.lastHash = initialEntries[initialEntries.length - 1]!.currentHash;
+    }
+  }
+
+  /**
+   * Appends an immutable, double-entry balanced journal entry with SHA-256 hash chaining.
+   * Throws if Debits != Credits or if any amount is non-positive.
+   */
+  async recordEntry(
+    referenceId: string,
+    description: string,
+    postings: JournalPosting[],
+    timestamp = Date.now()
+  ): Promise<JournalEntry> {
+    if (postings.length < 2) {
+      throw new Error('A journal entry must contain at least 2 postings.');
+    }
+
+    let totalDebits = 0;
+    let totalCredits = 0;
+
+    for (const p of postings) {
+      if (!Number.isSafeInteger(p.amountKobo) || p.amountKobo <= 0) {
+        throw new Error(`Posting amount must be a positive integer kobo. Received: ${p.amountKobo}`);
+      }
+      if (p.direction === 'DEBIT') {
+        totalDebits += p.amountKobo;
+      } else if (p.direction === 'CREDIT') {
+        totalCredits += p.amountKobo;
+      } else {
+        throw new Error(`Invalid posting direction: ${(p as any).direction}`);
+      }
+    }
+
+    // Double-entry fundamental accounting invariant
+    if (totalDebits !== totalCredits) {
+      throw new Error(
+        `UNBALANCED JOURNAL ENTRY: Sum of Debits (${totalDebits} kobo) must equal sum of Credits (${totalCredits} kobo).`
+      );
+    }
+
+    const id = `jrn_${timestamp}_${Math.random().toString(36).slice(2, 8)}`;
+    const postingsDigest = postings
+      .map((p) => `${p.accountId}:${p.direction}:${p.amountKobo}`)
+      .join('|');
+
+    // SHA-256 hash chain: currentHash = SHA256(previousHash + id + referenceId + postingsDigest + timestamp)
+    const payloadToHash = `${this.lastHash}:${id}:${referenceId}:${postingsDigest}:${timestamp}`;
+    const currentHash = await sha256Hex(payloadToHash);
+
+    const entry: JournalEntry = {
+      id,
+      referenceId,
+      description,
+      postings,
+      timestamp,
+      previousHash: this.lastHash,
+      currentHash,
+    };
+
+    this.entries.push(entry);
+    this.lastHash = currentHash;
+    return entry;
+  }
+
+  getEntries(): JournalEntry[] {
+    return [...this.entries];
+  }
+
+  /**
+   * Verifies the entire cryptographic integrity of the ledger hash chain.
+   */
+  async verifyChainIntegrity(): Promise<{ valid: boolean; brokenAtEntryId?: string }> {
+    let prev = '0'.repeat(64);
+
+    for (const entry of this.entries) {
+      if (entry.previousHash !== prev) {
+        return { valid: false, brokenAtEntryId: entry.id };
+      }
+
+      const postingsDigest = entry.postings
+        .map((p) => `${p.accountId}:${p.direction}:${p.amountKobo}`)
+        .join('|');
+
+      const expectedPayload = `${entry.previousHash}:${entry.id}:${entry.referenceId}:${postingsDigest}:${entry.timestamp}`;
+      const calculatedHash = await sha256Hex(expectedPayload);
+
+      if (entry.currentHash !== calculatedHash) {
+        return { valid: false, brokenAtEntryId: entry.id };
+      }
+
+      prev = entry.currentHash;
+    }
+
+    return { valid: true };
+  }
+
+  /**
+   * Computes the balance for a given account across all postings.
+   * Assets/Expenses balance = Debits - Credits
+   * Liabilities/Revenues balance = Credits - Debits
+   */
+  getAccountBalanceKobo(account: JournalPosting['accountId']): number {
+    let debits = 0;
+    let credits = 0;
+
+    for (const entry of this.entries) {
+      for (const p of entry.postings) {
+        if (p.accountId === account) {
+          if (p.direction === 'DEBIT') debits += p.amountKobo;
+          if (p.direction === 'CREDIT') credits += p.amountKobo;
+        }
+      }
+    }
+
+    if (account.startsWith('ASSET') || account.startsWith('EXPENSE')) {
+      return debits - credits;
+    }
+    return credits - debits;
+  }
+}
diff --git a/packages/shared/src/engines/ledger-escrow/escrow.ts b/packages/shared/src/engines/ledger-escrow/escrow.ts
new file mode 100644
index 0000000..765511c
--- /dev/null
+++ b/packages/shared/src/engines/ledger-escrow/escrow.ts
@@ -0,0 +1,172 @@
+import type {
+  EscrowAccount,
+  EscrowReleaseResult,
+  EscrowRefundResult,
+} from './types';
+import { CryptographicLedger } from './cryptographic-ledger';
+import { percentOfKobo } from '../../money';
+
+const FORTY_EIGHT_HOURS_MS = 48 * 60 * 60 * 1000;
+
+export class EscrowStateMachine {
+  constructor(private ledger: CryptographicLedger) {}
+
+  /**
+   * Initializes and holds escrow funds from the farmer.
+   */
+  async holdFunds(
+    escrowId: string,
+    bookingId: string,
+    farmerId: string,
+    providerId: string,
+    agreedPriceKobo: number,
+    commissionRatePercent = 5
+  ): Promise<{ escrow: EscrowAccount }> {
+    // 1. Post to double-entry ledger: Debit Escrow Asset, Credit Farmer Deposit Liability
+    await this.ledger.recordEntry(
+      bookingId,
+      `Escrow deposit held for booking ${bookingId}`,
+      [
+        {
+          accountId: 'ASSET_ESCROW_HOLDING',
+          direction: 'DEBIT',
+          amountKobo: agreedPriceKobo,
+          memo: `Funds held from farmer ${farmerId}`,
+        },
+        {
+          accountId: 'LIABILITY_FARMER_DEPOSIT',
+          direction: 'CREDIT',
+          amountKobo: agreedPriceKobo,
+          memo: `Farmer deposit liability for booking ${bookingId}`,
+        },
+      ]
+    );
+
+    const escrow: EscrowAccount = {
+      escrowId,
+      bookingId,
+      farmerId,
+      providerId,
+      agreedPriceKobo,
+      commissionRatePercent,
+      status: 'HELD',
+      heldAt: Date.now(),
+    };
+
+    return { escrow };
+  }
+
+  /**
+   * Marks job work completed and starts the 48-hour auto-release clock.
+   */
+  markWorkCompleted(escrow: EscrowAccount): EscrowAccount {
+    if (escrow.status !== 'HELD') {
+      throw new Error(`Cannot mark work completed from status: ${escrow.status}`);
+    }
+    const now = Date.now();
+    return {
+      ...escrow,
+      status: 'AWAITING_CONFIRMATION',
+      autoReleaseDeadline: now + FORTY_EIGHT_HOURS_MS,
+    };
+  }
+
+  /**
+   * Freezes escrow funds due to an opened dispute.
+   */
+  freezeForDispute(escrow: EscrowAccount): EscrowAccount {
+    if (escrow.status !== 'AWAITING_CONFIRMATION' && escrow.status !== 'HELD') {
+      throw new Error(`Cannot freeze escrow from status: ${escrow.status}`);
+    }
+    return {
+      ...escrow,
+      status: 'DISPUTE_FROZEN',
+    };
+  }
+
+  /**
+   * Releases escrow funds to provider upon confirmation or 48-hour auto-release expiry.
+   * Deducts platform commission in integer kobo.
+   */
+  async releaseFunds(escrow: EscrowAccount): Promise<EscrowReleaseResult> {
+    if (escrow.status !== 'AWAITING_CONFIRMATION' && escrow.status !== 'HELD') {
+      throw new Error(`Cannot release escrow from status: ${escrow.status}`);
+    }
+
+    const commissionKobo = percentOfKobo(escrow.agreedPriceKobo, escrow.commissionRatePercent);
+    const providerPayoutKobo = escrow.agreedPriceKobo - commissionKobo;
+
+    // Post to ledger:
+    // Debit: LIABILITY_FARMER_DEPOSIT (full amount)
+    // Credit: LIABILITY_PROVIDER_PAYABLE (net payout)
+    // Credit: REVENUE_PLATFORM_COMMISSION (commission)
+    const journalEntry = await this.ledger.recordEntry(
+      escrow.bookingId,
+      `Escrow settlement payout for booking ${escrow.bookingId}`,
+      [
+        {
+          accountId: 'LIABILITY_FARMER_DEPOSIT',
+          direction: 'DEBIT',
+          amountKobo: escrow.agreedPriceKobo,
+          memo: `Farmer deposit released`,
+        },
+        {
+          accountId: 'LIABILITY_PROVIDER_PAYABLE',
+          direction: 'CREDIT',
+          amountKobo: providerPayoutKobo,
+          memo: `Payable to provider ${escrow.providerId}`,
+        },
+        {
+          accountId: 'REVENUE_PLATFORM_COMMISSION',
+          direction: 'CREDIT',
+          amountKobo: commissionKobo,
+          memo: `Platform commission (${escrow.commissionRatePercent}%)`,
+        },
+      ]
+    );
+
+    escrow.status = 'SETTLED';
+    escrow.settledAt = Date.now();
+
+    return {
+      escrowId: escrow.escrowId,
+      providerPayoutKobo,
+      platformCommissionKobo: commissionKobo,
+      journalEntry,
+    };
+  }
+
+  /**
+   * Issues a full refund back to the farmer (e.g. cancelled or arbitrated no-show).
+   */
+  async refundFarmer(escrow: EscrowAccount): Promise<EscrowRefundResult> {
+    // Post to ledger: Debit LIABILITY_FARMER_DEPOSIT, Credit ASSET_ESCROW_HOLDING
+    const journalEntry = await this.ledger.recordEntry(
+      escrow.bookingId,
+      `Escrow refund to farmer for booking ${escrow.bookingId}`,
+      [
+        {
+          accountId: 'LIABILITY_FARMER_DEPOSIT',
+          direction: 'DEBIT',
+          amountKobo: escrow.agreedPriceKobo,
+          memo: `Farmer deposit refunded`,
+        },
+        {
+          accountId: 'ASSET_ESCROW_HOLDING',
+          direction: 'CREDIT',
+          amountKobo: escrow.agreedPriceKobo,
+          memo: `Escrow cash returned to farmer`,
+        },
+      ]
+    );
+
+    escrow.status = 'REFUNDED';
+    escrow.settledAt = Date.now();
+
+    return {
+      escrowId: escrow.escrowId,
+      refundFarmerKobo: escrow.agreedPriceKobo,
+      journalEntry,
+    };
+  }
+}
