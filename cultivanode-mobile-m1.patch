   auth: {
-    ...(Platform.OS !== 'web' ? { storage: AsyncStorage } : {}),
+    ...(Platform.OS !== 'web' ? { storage: sessionStorage } : {}),
     autoRefreshToken: true,
     persistSession: true,
+    storageKey: SESSION_KEY,
     detectSessionInUrl: false,
   },
 });
