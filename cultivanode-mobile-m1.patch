+// Phone sign-in. Codes are sent by the Supabase Auth Send SMS hook through the SMS provider chosen in the
+// admin console (same flow as the website). A new number gets an account; onboarding follows.
+import { reportError } from './monitoring';
+import { SESSION_KEY, sessionStorage, supabase } from './supabase';
+
+export type AuthErrorKey = 'errorPhone' | 'errorCode' | 'errorWrongCode' | 'errorBusy' | 'errorSend' | 'offline';
+
+function isNetworkError(error: { name?: string; message?: string; status?: number }): boolean {
+  return error.name === 'AuthRetryableFetchError' || error.status === 0 || /network|fetch/i.test(error.message ?? '');
+}
+
+/** Texts a 6-digit code to a normalised 234XXXXXXXXXX number. */
+export async function sendCode(phone: string): Promise<AuthErrorKey | null> {
+  const { error } = await supabase.auth.signInWithOtp({ phone: `+${phone}`, options: { shouldCreateUser: true } });
+  if (!error) return null;
+  if (isNetworkError(error)) return 'offline';
+  if (error.status === 429) return 'errorBusy';
+  reportError('sign_in_code_failed', error, { reason: error.code ?? error.name, status: error.status ?? 0 });
+  return 'errorSend';
+}
+
+/** Checks the code; on success Supabase stores the (encrypted) session and fires onAuthStateChange. */
+export async function verifyCode(phone: string, code: string): Promise<AuthErrorKey | null> {
+  const token = code.replace(/\s+/g, '');
+  if (!/^[0-9]{6}$/.test(token)) return 'errorCode';
+  const { data, error } = await supabase.auth.verifyOtp({ phone: `+${phone}`, token, type: 'sms' });
+  if (error && isNetworkError(error)) return 'offline';
+  if (error?.status === 429) return 'errorBusy';
+  if (error || !data.session) return 'errorWrongCode';
+  return null;
+}
+
+/**
+ * 'local' always clears this phone's session (even offline). 'global' needs the server to end every
+ * session, so it returns false when that could not be confirmed and the person stays signed in here.
+ */
+export async function signOut(scope: 'local' | 'global' = 'local'): Promise<boolean> {
+  const { error } = await supabase.auth.signOut({ scope });
+  if (error && scope === 'local') {
+    // Offline: the server could not be told, but the session must still leave this phone.
+    await sessionStorage.removeItem(SESSION_KEY).catch(() => undefined);
+    return true;
+  }
+  return !error;
+}
diff --git a/apps/mobile/src/lib/encrypted-storage.ts b/apps/mobile/src/lib/encrypted-storage.ts
new file mode 100644
index 0000000..f2c889d
--- /dev/null
+++ b/apps/mobile/src/lib/encrypted-storage.ts
@@ -0,0 +1,90 @@
+// Encrypted key-value storage for the Supabase session on the phone.
+//
+// The session (access and refresh tokens) is too large for the phone's secure keystore on Android,
+// so we follow Supabase's recommended pattern: every write gets a fresh random 256-bit AES key,
+// the key goes into the secure keystore (Android Keystore / iOS Keychain via expo-secure-store),
+// and the encrypted session goes into ordinary app storage (AsyncStorage). Reading app storage alone
+// (backup, rooted phone, file copy) reveals nothing without the key held by the keystore.
+//
+// This module has no React Native imports so it can be unit-tested in Node; secure-session.ts wires
+// in the real keystore, storage and random bytes.
+import aesjs from 'aes-js';
+
+export type KeyStore = {
+  get(key: string): Promise<string | null>;
+  set(key: string, value: string): Promise<void>;
+  remove(key: string): Promise<void>;
+};
+
+export type DataStore = {
+  getItem(key: string): Promise<string | null>;
+  setItem(key: string, value: string): Promise<void>;
+  removeItem(key: string): Promise<void>;
+};
+
+export type EncryptedStorageDeps = {
+  keyStore: KeyStore;
+  dataStore: DataStore;
+  randomBytes: (length: number) => Uint8Array;
+};
+
+const FORMAT = 'v1';
+// Prefixed to the plaintext so a wrong key (CTR mode never "fails") is detected instead of returning noise.
+const MARKER = 'cn1|';
+
+/** expo-secure-store keys may only contain letters, digits, '.', '-' and '_'. */
+export function keystoreName(key: string): string {
+  return `cn.key.${key.replace(/[^A-Za-z0-9._-]/g, '_')}`;
+}
+
+export function encrypt(plain: string, key: Uint8Array, iv: Uint8Array): string {
+  const ctr = new aesjs.ModeOfOperation.ctr(key, new aesjs.Counter(iv));
+  const cipher = ctr.encrypt(aesjs.utils.utf8.toBytes(MARKER + plain));
+  return `${FORMAT}:${aesjs.utils.hex.fromBytes(iv)}:${aesjs.utils.hex.fromBytes(cipher)}`;
+}
+
+/** Returns null for anything that is not a well-formed v1 value. */
+export function decrypt(stored: string, key: Uint8Array): string | null {
+  const [format, ivHex, cipherHex] = stored.split(':');
+  if (format !== FORMAT || !ivHex || cipherHex === undefined || ivHex.length !== 32) return null;
+  try {
+    const ctr = new aesjs.ModeOfOperation.ctr(key, new aesjs.Counter(aesjs.utils.hex.toBytes(ivHex)));
+    const plain = aesjs.utils.utf8.fromBytes(ctr.decrypt(aesjs.utils.hex.toBytes(cipherHex)));
+    return plain.startsWith(MARKER) ? plain.slice(MARKER.length) : null;
+  } catch {
+    return null;
+  }
+}
+
+/** A storage adapter with the shape supabase-js expects (getItem / setItem / removeItem). */
+export function createEncryptedStorage({ keyStore, dataStore, randomBytes }: EncryptedStorageDeps) {
+  async function removeItem(key: string): Promise<void> {
+    await Promise.all([dataStore.removeItem(key), keyStore.remove(keystoreName(key))]);
+  }
+
+  return {
+    async getItem(key: string): Promise<string | null> {
+      const [stored, keyHex] = await Promise.all([dataStore.getItem(key), keyStore.get(keystoreName(key))]);
+      if (!stored || !keyHex || keyHex.length !== 64) return null;
+      const plain = decrypt(stored, aesjs.utils.hex.toBytes(keyHex));
+      if (plain === null) {
+        // Damaged or tampered: forget it, which simply signs the person out.
+        await removeItem(key);
+        return null;
+      }
+      return plain;
+    },
+
+    async setItem(key: string, value: string): Promise<void> {
+      const aesKey = randomBytes(32);
+      const iv = randomBytes(16);
+      const stored = encrypt(value, aesKey, iv);
+      // Key first: if the app dies between the two writes, the old ciphertext no longer matches the key,
+      // the marker check fails and the person is simply signed out.
+      await keyStore.set(keystoreName(key), aesjs.utils.hex.fromBytes(aesKey));
+      await dataStore.setItem(key, stored);
+    },
+
+    removeItem,
+  };
+}
diff --git a/apps/mobile/src/lib/monitoring.ts b/apps/mobile/src/lib/monitoring.ts
new file mode 100644
index 0000000..58ae72b
--- /dev/null
+++ b/apps/mobile/src/lib/monitoring.ts
@@ -0,0 +1,53 @@
+// Crash reporting with Sentry. Off unless EXPO_PUBLIC_SENTRY_DSN is set, and even then no personal data
+// is sent: no user identity, no request bodies, and every message passes through redact().
+import * as Sentry from '@sentry/react-native';
+import type { ComponentType } from 'react';
+import { redact, redactString } from './redact';
+
+const dsn = process.env.EXPO_PUBLIC_SENTRY_DSN;
+export const monitoringEnabled = Boolean(dsn);
+
+export function initMonitoring(): void {
+  if (!dsn) return;
+  Sentry.init({
+    dsn,
+    environment: process.env.EXPO_PUBLIC_APP_ENV ?? 'development',
+    sendDefaultPii: false,
+    tracesSampleRate: 0,
+    attachScreenshot: false,
+    attachViewHierarchy: false,
+    beforeSend(event) {
+      delete event.user;
+      delete event.request;
+      if (event.message) event.message = redactString(event.message);
+      for (const ex of event.exception?.values ?? []) {
+        if (ex.value) ex.value = redactString(ex.value);
+      }
+      if (event.extra) event.extra = redact(event.extra);
+      if (event.contexts) event.contexts = redact(event.contexts);
+      event.breadcrumbs = event.breadcrumbs?.map((b) => redact(b));
+      return event;
+    },
+    beforeBreadcrumb(crumb) {
+      // Console output and network bodies can hold personal data; keep navigation and UI taps only.
+      if (crumb.category === 'console' || crumb.category === 'xhr' || crumb.category === 'fetch') return null;
+      return redact(crumb);
+    },
+  });
+}
+
+/** Wraps the root component so Sentry can catch render errors; a no-op when monitoring is off. */
+export function withMonitoring(App: ComponentType): ComponentType {
+  return dsn ? Sentry.wrap(App as ComponentType<Record<string, unknown>>) : App;
+}
+
+/** Reports an unexpected error. Pass a short event name and codes only, never personal data. */
+export function reportError(event: string, error: unknown, data?: Record<string, string | number | boolean>): void {
+  if (__DEV__) console.warn(event, redact(data ?? {}));
+  if (!dsn) return;
+  Sentry.withScope((scope) => {
+    scope.setTag('event', event);
+    if (data) scope.setExtras(redact(data));
+    Sentry.captureException(error instanceof Error ? error : new Error(event));
+  });
+}
