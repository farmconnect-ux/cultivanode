diff --git a/supabase/migrations/20260927011448_weather_providers.sql b/supabase/migrations/20260927011448_weather_providers.sql
new file mode 100644
index 0000000..0861a48
--- /dev/null
+++ b/supabase/migrations/20260927011448_weather_providers.sql
@@ -0,0 +1,31 @@
+-- Weather providers, chosen and keyed in Admin > Integrations like SMS and identity.
+--   weatherapi: WeatherAPI.com (commercial use allowed on paid plans). Key stored in Vault.
+--   open_meteo: free, non-commercial only, so it is marked test-only (refused when APP_ENV=production).
+-- The `weather` Edge Function fetches forecasts for the pilot states and caches them in weather_cache
+-- for 30 minutes so the provider is called at most 6 times per half hour.
+
+insert into public.integration_providers
+  (code, kind, name, description, docs_url, implemented, test_only, config_fields, secret_fields, sort_order)
+values
+  ('weatherapi', 'weather', 'WeatherAPI.com',
+   'Current weather and daily forecasts for the pilot states. The number of forecast days depends on your plan (free plans return 3).',
+   'https://www.weatherapi.com/docs/', true, false,
+   '[{"key":"days","label":"Forecast days","required":true,"default":"7","options":["3","7","10","14"],"help":"Days to request; your plan may return fewer."}]',
+   '[{"key":"api_key","label":"API key","required":true,"help":"From your WeatherAPI.com dashboard."}]', 10),
+  ('open_meteo', 'weather', 'Open-Meteo (free, non-commercial)',
+   'Free forecasts without a key, for development. Commercial use needs an Open-Meteo plan, so it is refused in production.',
+   'https://open-meteo.com/en/docs', true, true, '[]', '[]', 90);
+
+-- WeatherAPI keys are live keys; start it in live mode so the key goes where it will be used.
+insert into public.integration_configs (provider, mode) values ('weatherapi', 'live');
+insert into public.integration_settings (kind, active_provider) values ('weather', 'weatherapi');
+
+-- Latest forecast per provider. Written by the Edge Function (service role) only; no API access.
+create table public.weather_cache (
+  provider    text primary key references public.integration_providers (code) on delete cascade,
+  payload     jsonb not null,
+  fetched_at  timestamptz not null default now()
+);
+comment on table public.weather_cache is 'Last pilot-state forecast per weather provider (30-minute cache). Service role only.';
+alter table public.weather_cache enable row level security;
+revoke all on public.weather_cache from anon, authenticated;
diff --git a/supabase/tests/database/10_weather.test.sql b/supabase/tests/database/10_weather.test.sql
new file mode 100644
index 0000000..e6ca747
--- /dev/null
+++ b/supabase/tests/database/10_weather.test.sql
@@ -0,0 +1,37 @@
+-- Weather as a switchable integration (WeatherAPI.com by default) and its service-only cache.
+-- Run with: supabase test db
+begin;
+create extension if not exists pgtap with schema extensions;
+select plan(9);
+
+select is((select active_provider from public.integration_settings where kind = 'weather'), 'weatherapi',
+  'WeatherAPI.com is the weather provider in use');
+select is((select mode::text from public.integration_configs where provider = 'weatherapi'), 'live',
+  'WeatherAPI.com starts in live mode, where its key belongs');
+select ok((select test_only from public.integration_providers where code = 'open_meteo'),
+  'free Open-Meteo is test-only (refused in production)');
+
+set local role service_role;
+select is((public.integration_runtime('weather') ->> 'missing'), '["key:api_key"]',
+  'until staff add the key, the runtime reports it missing');
+select is((public.integration_runtime('weather') -> 'config' ->> 'days'), '7', 'seven forecast days by default');
+reset role;
+
+insert into auth.users (id, phone) values ('a0000000-0000-0000-0000-000000000001', '2348000001001');
+insert into public.admin_roles (profile_id, admin_role) values ('a0000000-0000-0000-0000-000000000001', 'super_admin');
+insert into public.weather_cache (provider, payload) values ('weatherapi', '{"forecasts": []}');
+
+set local role authenticated;
+select set_config('request.jwt.claims', '{"sub":"a0000000-0000-0000-0000-000000000001"}', true);
+select throws_ok($$ select * from public.weather_cache $$, '42501', null, 'even staff cannot read the cache directly');
+select lives_ok($$ select public.admin_set_integration_secret('weatherapi', 'live', 'api_key', 'WAtestkey00000000000000000000') $$,
+  'staff with integrations.manage store the WeatherAPI key (encrypted in Vault)');
+reset role;
+set local role service_role;
+select is((public.integration_runtime('weather') ->> 'missing'), '[]', 'with the key stored, weather is ready');
+reset role;
+set local role anon;
+select throws_ok($$ select * from public.weather_cache $$, '42501', null, 'visitors cannot read the cache');
+
+select * from finish();
+rollback;
