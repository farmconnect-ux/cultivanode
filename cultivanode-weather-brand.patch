+  current: { temp_c: 28.2, humidity: 79, wind_kph: 11.2, condition: { code: 1003 } },
+  forecast: {
+    forecastday: [
+      { date: '2026-09-27', day: { maxtemp_c: 30.1, mintemp_c: 22.4, totalprecip_mm: rain, daily_chance_of_rain: 86, maxwind_kph: 14, condition: { code: 1189 } } },
