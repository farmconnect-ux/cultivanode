{
  "name": "cultivanode",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace @cultivanode/web",
    "dev:mobile": "npm run start --workspace @cultivanode/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:types:remote": "supabase gen types typescript --project-id vqbtnftnxyfaembwgfrk --schema public > packages/shared/src/database.types.ts",
    "brand:icons": "node --experimental-strip-types scripts/brand-icons.ts"
  },
  "devDependencies": {
    "supabase": "^2.118.0",
    "turbo": "^2.11.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "expo-sqlite": "~57.0.3"
  }
}
