+  harvests: CropHarvest[];
+  alerts: CropAlert[];
+}
+
+export function CropCycleDetailView({
+  lang,
+  cycle,
+  plot,
+  operations,
+  observations,
+  measurements,
+  inputs,
+  harvests,
+  alerts,
