+            </Button>
+          )}
+
+          {cycle.status === "active" && (
+            <Button
+              type="button"
+              variant="secondary"
+              onClick={() => {
+                setActiveModal("addHarvest");
+              }}
+            >
+              🌾 Record First Harvest
+            </Button>
+          )}
+
+          {cycle.status === "harvesting" && (
+            <Button
+              type="button"
+              onClick={async () => {
+                await completeCropCycleAction(cycle.id);
+              }}
+            >
