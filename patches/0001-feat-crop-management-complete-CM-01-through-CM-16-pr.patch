@@ -0,0 +1,72 @@
+import { describe, expect, it } from 'vitest';
+import { OfflineSyncQueue, type SyncStorage } from '../offline-sync';
+
+function createMockStorage(): SyncStorage {
+  const store = new Map<string, string>();
+  return {
+    getItem: async (k: string) => store.get(k) ?? null,
+    setItem: async (k: string, v: string) => void store.set(k, v),
+  };
+}
+
+describe('Offline Sync Queue (CM-15)', () => {
+  it('enqueues offline items and persists in storage', async () => {
+    const storage = createMockStorage();
+    const queue = new OfflineSyncQueue(storage);
+
+    const item1 = await queue.enqueue('scouting_observation', {
+      cycleId: 'cycle_1',
+      category: 'pest',
+      severity: 'high',
+      description: 'Fall armyworm in Block B',
+    });
+
+    const item2 = await queue.enqueue('complete_operation', {
+      operationId: 'op_1',
+      actualCostKobo: 500000,
+    });
+
+    const all = await queue.getQueue();
+    expect(all).toHaveLength(2);
+    expect(all[0]?.id).toBe(item1.id);
+    expect(all[1]?.id).toBe(item2.id);
+  });
+
+  it('successfully processes queue items and removes synced records', async () => {
+    const storage = createMockStorage();
+    const queue = new OfflineSyncQueue(storage);
+
+    await queue.enqueue('scouting_observation', { note: 'test 1' });
+    await queue.enqueue('scouting_observation', { note: 'test 2' });
+
+    const result = await queue.processSync(async (item) => {
+      // simulate network upload success
+      return true;
+    });
+
+    expect(result.synced).toBe(2);
+    expect(result.failed).toBe(0);
+
+    const remaining = await queue.getQueue();
+    expect(remaining).toHaveLength(0);
+  });
+
+  it('retains failed items with incremented attempt count', async () => {
+    const storage = createMockStorage();
+    const queue = new OfflineSyncQueue(storage);
+
+    await queue.enqueue('scouting_observation', { note: 'offline failing item' });
+
+    const result = await queue.processSync(async () => {
+      // simulate network error
+      return false;
+    });
+
+    expect(result.synced).toBe(0);
+    expect(result.failed).toBe(1);
+
+    const remaining = await queue.getQueue();
+    expect(remaining).toHaveLength(1);
+    expect(remaining[0]?.attempts).toBe(1);
+  });
+});
diff --git a/apps/mobile/src/lib/offline-sync.ts b/apps/mobile/src/lib/offline-sync.ts
new file mode 100644
index 0000000..323f89a
--- /dev/null
+++ b/apps/mobile/src/lib/offline-sync.ts
@@ -0,0 +1,92 @@
+// Offline sync queue for field agents and farmers in rural low-connectivity areas.
+// Stores pending scouting logs, measurements, and completed operations locally
+// and synchronizes deterministically once an internet connection is re-established.
+
+export type SyncItemKind = 'scouting_observation' | 'complete_operation' | 'crop_measurement' | 'harvest_record';
+
+export interface PendingSyncItem {
+  id: string;
+  kind: SyncItemKind;
+  payload: Record<string, unknown>;
+  createdAt: string;
+  attempts: number;
+  lastError?: string;
+}
+
+export interface SyncStorage {
+  getItem(key: string): Promise<string | null>;
+  setItem(key: string, value: string): Promise<void>;
+}
+
+const STORAGE_KEY = 'cn_offline_sync_queue_v1';
+
+export class OfflineSyncQueue {
+  private storage: SyncStorage;
+
+  constructor(storage: SyncStorage) {
+    this.storage = storage;
+  }
+
+  async getQueue(): Promise<PendingSyncItem[]> {
+    try {
+      const raw = await this.storage.getItem(STORAGE_KEY);
+      if (!raw) return [];
+      return JSON.parse(raw) as PendingSyncItem[];
+    } catch {
+      return [];
+    }
+  }
+
+  async enqueue(kind: SyncItemKind, payload: Record<string, unknown>): Promise<PendingSyncItem> {
+    const queue = await this.getQueue();
+    const item: PendingSyncItem = {
+      id: `offline_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
+      kind,
+      payload,
+      createdAt: new Date().toISOString(),
+      attempts: 0,
+    };
+
+    queue.push(item);
+    await this.storage.setItem(STORAGE_KEY, JSON.stringify(queue));
+    return item;
+  }
+
+  async remove(id: string): Promise<void> {
+    const queue = await this.getQueue();
+    const filtered = queue.filter((i) => i.id !== id);
+    await this.storage.setItem(STORAGE_KEY, JSON.stringify(filtered));
+  }
+
+  async processSync(
+    handler: (item: PendingSyncItem) => Promise<boolean>
+  ): Promise<{ synced: number; failed: number }> {
+    const queue = await this.getQueue();
+    if (queue.length === 0) return { synced: 0, failed: 0 };
+
+    let synced = 0;
+    let failed = 0;
+    const remaining: PendingSyncItem[] = [];
+
+    for (const item of queue) {
+      try {
+        const success = await handler(item);
+        if (success) {
+          synced++;
+        } else {
+          item.attempts += 1;
+          remaining.push(item);
+          failed++;
+        }
+      } catch (err) {
+        item.attempts += 1;
+        item.lastError = String(err);
+        remaining.push(item);
+        failed++;
+      }
+    }
+
+    await this.storage.setItem(STORAGE_KEY, JSON.stringify(remaining));
+    return { synced, failed };
+  }
+}
