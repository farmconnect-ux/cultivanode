+        </div>
+      </div>
+
+      {/* Tabs Bar */}
+      <div className="flex items-center gap-1 border-b border-neutral-200 overflow-x-auto pb-1">
+        {[
+          { id: "overview", label: "Overview", icon: "📋" },
+          { id: "operations", label: `Operations (${operations.length})`, icon: "🚜" },
